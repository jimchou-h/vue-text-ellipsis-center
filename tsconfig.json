{
  "compilerOptions": {
    "emitDeclarationOnly": false,
    "target": "ESNext",
    "module": "ESNext", // 使用 ESM 模块
    "jsx": "preserve", // 支持 JSX
    "jsxImportSource": "vue", // 关键
    // "types": ["vue/jsx"],
    "strict": true,
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    // "allowImportingTsExtensions": true, // 允许导入 .tsx 扩展名
    "paths": {
      "vue-text-ellipsis-center": ["src/index.ts"],
      "vue-text-ellipsis-center/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
