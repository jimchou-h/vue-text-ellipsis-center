{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",              // 使用 ESM 模块
    "declaration": true,             // 生成 .d.ts 类型声明
    "declarationDir": "dist/types",  // 类型输出目录
    "outDir": "lib/es",             // JS 输出目录（可被忽略，Vite 控制输出）
    "strict": true,
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}